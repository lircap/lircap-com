---
const routes = [
  { href: '/for-investors/', label: 'For investors', meta: 'Capital counterparties exploring fit and timing' },
  { href: '/for-deals/', label: 'For deals', meta: 'Owners and advisers exploring capital context' },
];
---

<section class="crossing-hero" aria-labelledby="hero-title">
  <div class="crossing-hero__copy">
    <p class="eyebrow">The crossing</p>
    <div class="crossing-hero__lockup">
      <h1 id="hero-title">Where capital and opportunity intersect.</h1>
      <div class="crossing-hero__chart" role="img" aria-label="Abstract navigational crossing: two refined plotted paths meeting at a fix">
        <div class="chart-frame">
          <span class="chart-rim" aria-hidden="true"></span>
          <span class="bearing bearing--north" aria-hidden="true"></span>
          <span class="bearing bearing--east" aria-hidden="true"></span>
          <span class="track track--capital" aria-hidden="true"></span>
          <span class="track track--opportunity" aria-hidden="true"></span>
          <span class="fix" aria-hidden="true"></span>
          <span class="soundings sounding--one" aria-hidden="true">capital</span>
          <span class="soundings sounding--two" aria-hidden="true">opportunity</span>
        </div>
      </div>
    </div>
    <p class="lede">
      Lir Capital works at the point where capital needs a considered path and complex
      opportunities need the right counterparties. Discreet, partner-led conversations;
      no public mandate claims, no market noise.
    </p>
    <div class="hero-actions" aria-label="Primary journeys">
      {routes.map((route) => (
        <a class="journey-card" href={route.href}>
          <span>{route.label}</span>
          <small>{route.meta}</small>
        </a>
      ))}
    </div>
  </div>
</section>
