---
import BaseLayout from '../layouts/BaseLayout.astro';
import { teamMembers } from '../content/team.js';
import { getSeo } from '../data/seo.js';

const seo = getSeo('/team/');
---

<BaseLayout {...seo}>
  <section class="team-page" aria-labelledby="page-title">
    <div class="team-hero">
      <p class="eyebrow">Partner-led judgement</p>
      <h1 id="page-title">Senior attention, clear accountability.</h1>
      <p class="lede">
        Lir Capital is built around senior people who bring sector judgement, relationships and operating context to private conversations.
      </p>
    </div>

    <section class="team-roster" aria-labelledby="team-roster-title">
      <div class="section-heading">
        <p class="eyebrow">Team</p>
        <div>
          <h2 id="team-roster-title">Partners and advisers</h2>
          <p>
            Each profile reserves a neutral portrait slot for the approved photography set. No stock or generated imagery is used.
          </p>
        </div>
      </div>

      <ul class="team-grid" role="list">
        {teamMembers.map((member) => (
          <li class="team-card" id={member.id} aria-labelledby={`${member.id}-name`} role="listitem">
            <div class="portrait-placeholder" aria-label={`Portrait slot pending approved photography for ${member.name}`}>
              <span>IMAGE — PARTNER PORTRAIT</span>
              <strong>{member.portraitAssetId}</strong>
            </div>
            <div class="team-card__body">
              <p class="team-card__meta">{member.role}</p>
              <h3 id={`${member.id}-name`}>{member.name}</h3>
              <p class="team-card__location">{member.locationLabel}</p>
              {member.webBio.map((paragraph) => <p>{paragraph}</p>)}
              <div class="team-card__focus" aria-label={`${member.name} focus areas`}>
                {member.focusAreas.map((focus) => <span>{focus}</span>)}
              </div>
            </div>
          </li>
        ))}
      </ul>
    </section>

  </section>
</BaseLayout>
