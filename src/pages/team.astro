---
import BaseLayout from '../layouts/BaseLayout.astro';
import { teamMembers } from '../content/team.js';
import { getSeo } from '../data/seo.js';

const seo = getSeo('/team/');
---

<BaseLayout {...seo}>
  <section class="team-page" aria-labelledby="page-title">
    <div class="team-hero">
      <div class="team-hero__copy">
        <p class="eyebrow">Partner-led judgement</p>
        <h1 id="page-title">Senior attention, clear accountability.</h1>
        <p class="lede">
          Lir Capital is built around senior people who bring sector judgement, relationships and operating context to private conversations.
        </p>
      </div>
      <div class="team-crossing-map" aria-hidden="true">
        <span class="team-crossing-map__label">bearing</span>
        <span class="team-crossing-map__track team-crossing-map__track--capital"></span>
        <span class="team-crossing-map__track team-crossing-map__track--opportunity"></span>
        <span class="team-crossing-map__fix"></span>
        <span class="team-crossing-map__note team-crossing-map__note--one">capital</span>
        <span class="team-crossing-map__note team-crossing-map__note--two">opportunity</span>
      </div>
    </div>

    <section class="team-roster" aria-labelledby="team-roster-title">
      <div class="section-heading">
        <p class="eyebrow">Team</p>
        <div>
          <h2 id="team-roster-title">Partners and advisers</h2>
          <p>
            Team profiles are presented without stock or generated imagery while the approved photography set remains
            pending.
          </p>
        </div>
      </div>

      <ul class="team-grid" role="list">
        {teamMembers.map((member) => (
          <li class="team-card" id={member.id} aria-labelledby={`${member.id}-name`} role="listitem">
            <div class="portrait-placeholder" aria-label={`No portrait currently published for ${member.name}`}>
              <span class="portrait-placeholder__mark" aria-hidden="true">{member.name.split(' ').map((part) => part[0]).join('')}</span>
              <span class="portrait-placeholder__note">Portrait pending</span>
            </div>
            <div class="team-card__body">
              <p class="team-card__meta">{member.role}</p>
              <h3 id={`${member.id}-name`}>{member.name}</h3>
              <p class="team-card__location">{member.locationLabel}</p>
              {member.webBio.map((paragraph) => <p>{paragraph}</p>)}
              <div class="team-card__focus" aria-label={`${member.name} focus areas`}>
                {member.focusAreas.map((focus) => <span>{focus}</span>)}
              </div>
            </div>
          </li>
        ))}
      </ul>
    </section>

  </section>
</BaseLayout>
