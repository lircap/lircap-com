---
import BaseLayout from '../layouts/BaseLayout.astro';
import CrossingHero from '../components/CrossingHero.astro';
import { getSeo } from '../data/seo.js';

const seo = getSeo('/');
---

<BaseLayout {...seo}>
  <CrossingHero />

  <section class="home-brief" aria-labelledby="home-brief-title">
    <div class="section-heading">
      <p class="eyebrow">One function, two directions</p>
      <h2 id="home-brief-title">A senior route into the right conversation.</h2>
    </div>
    <div class="brief-grid">
      <article>
        <h3>For capital</h3>
        <p>
          Understanding mandate, appetite and timing before a conversation becomes a transaction.
        </p>
      </article>
      <article>
        <h3>For opportunities</h3>
        <p>
          Helping owners and advisers frame what kind of capital partner the situation requires.
        </p>
      </article>
      <article>
        <h3>For introductions</h3>
        <p>
          A discreet partner-led route when judgement, context and fit matter more than volume.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
