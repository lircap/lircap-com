---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Lir Capital — partner-led capital advisory"
  description="Lir Capital is a discreet, partner-led advisory and capital platform."
>
  <section class="hero" aria-labelledby="hero-title">
    <div>
      <p class="eyebrow">The crossing</p>
      <h1 id="hero-title">Where capital and opportunity find their fix.</h1>
      <div class="crossing-rule" aria-hidden="true"></div>
      <p class="lede">
        A static-first foundation for the Lir Capital website, ready for issue-bounded content,
        design, compliance, and browser QA work.
      </p>
    </div>
  </section>
</BaseLayout>
