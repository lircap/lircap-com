---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSeo } from '../data/seo.js';

const contactEmail = 'partners@lircap.com';
const mailtoHref = `mailto:${contactEmail}?subject=Lir%20Capital%20enquiry`;
const seo = getSeo('/contact/');

const enquiryIntents = [
  {
    label: 'Capital relationships',
    summary: 'For institutional, family-office, or professional counterparties exploring whether a conversation is appropriate.',
    instruction: 'Include your organisation, jurisdiction, areas of focus, and why the timing is relevant.',
  },
  {
    label: 'Company or transaction introductions',
    summary: 'For owners, companies, advisers, and trusted introducers considering a discreet first discussion.',
    instruction: 'Outline the business, your role, the situation, timing, and any confidentiality restrictions.',
  },
  {
    label: 'General or senior introductions',
    summary: 'For relationship-led enquiries where a direct note is the most proportionate starting point.',
    instruction: 'Say who you are hoping to reach, the nature of the introduction, and preferred follow-up details.',
  },
];
---

<BaseLayout {...seo}>
  <section class="contact-page" aria-labelledby="page-title">
    <div class="contact-hero">
      <p class="eyebrow">Contact</p>
      <h1 id="page-title">Start with a direct note.</h1>
      <p class="lede">
        For a discreet first conversation with Lir Capital, email the team directly. A short, practical note helps us
        understand fit, context and timing, and route the enquiry carefully.
      </p>
      <a class="contact-email" href={mailtoHref} aria-label={`Email Lir Capital at ${contactEmail}`}>
        {contactEmail}
      </a>
    </div>

    <section class="contact-section" aria-labelledby="routing-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">What to include</p>
          <h2 id="routing-title">Give enough context for a sensible first response.</h2>
        </div>
        <p>
          Please use the subject line or opening sentence to make the nature of the enquiry clear. This is not an offer, invitation, or solicitation, nor a suitability process or investor categorisation.
        </p>
      </div>

      <ul class="intent-grid" role="list">
        {enquiryIntents.map((intent) => (
          <li class="intent-card" role="listitem">
            <h3>{intent.label}</h3>
            <p>{intent.summary}</p>
            <small>{intent.instruction}</small>
          </li>
        ))}
      </ul>
    </section>

    <section class="contact-note" aria-labelledby="privacy-title">
      <div>
        <p class="eyebrow">What happens next</p>
        <h2 id="privacy-title">A careful reply, then an appropriate route.</h2>
      </div>
      <div class="contact-note__body">
        <p>
          If the enquiry appears relevant, a member of the team will respond by email to arrange a suitable next step or
          ask for clarifying context. If it is not a fit, we may say so directly.
        </p>
        <p>
          Please do not send login credentials, bank details, inside information, personal identification documents, or
          confidential transaction materials until an appropriate channel has been agreed.
        </p>
      </div>
    </section>
  </section>
</BaseLayout>
