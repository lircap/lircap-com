---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSeo } from '../data/seo.js';

const seo = getSeo('/legal/');
---

<BaseLayout {...seo}>
  <section class="legal-page" aria-labelledby="page-title">
    <div class="legal-page__intro">
      <p class="eyebrow">Legal and disclosure status</p>
      <h1 id="page-title">Current disclosure posture.</h1>
      <p class="lede">
        This pre-production site uses only confirmed registration facts. Fuller legal, regulatory,
        privacy and data-processing wording remains subject to Company Secretary, compliance and/or counsel review.
      </p>
    </div>

    <div class="legal-panel" aria-labelledby="entity-disclosure">
      <h2 id="entity-disclosure">Entity disclosure</h2>
      <p>
        Harmonycove Limited trading as Lir Capital Partners. Registered in Ireland. Company No. 801328.
      </p>
      <p>
        No regulatory authorisation, financial-promotion, office-location, or jurisdictional-compliance statement is made
        on this page unless separately confirmed and recorded in the compliance gate.
      </p>
    </div>

    <div class="legal-grid" aria-label="Compliance status summary">
      <article>
        <h2>Claims gate</h2>
        <p>
          Website copy is controlled by the claims register and compliance sign-off tracker. Claims that need substantiation,
          counsel, consent, or softening are excluded from public copy until cleared.
        </p>
      </article>
      <article>
        <h2>Financial promotion</h2>
        <p>
          This site does not make an offer, invitation, or solicitation. Private-markets, SPV, fund, investment-opportunity,
          and professional-counterparty language remains excluded unless counsel-cleared.
        </p>
      </article>
      <article>
        <h2>Privacy</h2>
        <p>
          Contact, analytics, processor, retention, and privacy-policy decisions are not final. The contact route should remain
          minimal until the data-protection position is recorded.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
