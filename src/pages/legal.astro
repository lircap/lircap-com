---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSeo } from '../data/seo.js';

const seo = getSeo('/legal/');
---

<BaseLayout {...seo}>
  <section class="legal-page" aria-labelledby="page-title">
    <div class="legal-page__intro">
      <p class="eyebrow">Legal</p>
      <h1 id="page-title">Company disclosure.</h1>
      <p class="lede">
        This page keeps public legal information limited to confirmed company details and conservative website-use
        notes. It does not add regulatory, jurisdictional, office-location, or legal-status wording that has not been
        separately confirmed.
      </p>
    </div>

    <div class="legal-panel" aria-labelledby="entity-disclosure">
      <h2 id="entity-disclosure">Entity disclosure</h2>
      <p>
        Harmonycove Limited trading as Lir Capital Partners. Registered in Ireland. Company No. 801328.
      </p>
      <p>
        References to Lir Capital or Lir Capital Partners on this website are references to that trading name unless
        otherwise stated.
      </p>
    </div>

    <div class="legal-grid" aria-label="Website legal notes">
      <article>
        <h2>Website content</h2>
        <p>
          The site is provided for general information. It should not be treated as legal, tax, investment, accounting,
          or other professional advice.
        </p>
      </article>
      <article>
        <h2>No offer</h2>
        <p>
          Nothing on this website is an offer, invitation, solicitation, recommendation, or commitment to provide
          finance, services, securities, or investment opportunity access.
        </p>
      </article>
      <article>
        <h2>Contact</h2>
        <p>
          Please do not send confidential or sensitive materials by email until an appropriate route for receiving them
          has been agreed.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
