---
import '../styles/global.css';
import { absoluteUrl, organizationJsonLd, siteName, websiteJsonLd } from '../data/seo.js';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  robots?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'Lir Capital',
  description = 'A discreet, partner-led advisory and capital platform.',
  canonicalPath = Astro.url.pathname,
  robots = 'index,follow',
  structuredData = [],
} = Astro.props;

const currentPath = Astro.url.pathname;
const canonicalUrl = absoluteUrl(canonicalPath);
const jsonLdItems = [organizationJsonLd(), websiteJsonLd(), ...(Array.isArray(structuredData) ? structuredData : [structuredData])]
  .filter(Boolean);
const jsonLdString = JSON.stringify(jsonLdItems.length === 1 ? jsonLdItems[0] : jsonLdItems).replace(/</g, '\\u003c');
const primaryNav = [
  { href: '/', label: 'Home', cue: 'Crossing' },
  { href: '/for-investors/', label: 'For investors', cue: 'Capital' },
  { href: '/for-deals/', label: 'For deals', cue: 'Opportunities' },
  { href: '/team/', label: 'Team', cue: 'People' },
  { href: '/contact/', label: 'Contact', cue: 'Discreet enquiry' },
];

const isActive = (href: string) => currentPath === href || (href !== '/' && currentPath.startsWith(href));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={jsonLdString}></script>
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-frame" aria-hidden="true"></div>
    <div class="site-shell">
      <header class="site-header" aria-label="Site header">
        <a class="brand-lockup" href="/" aria-label="Lir Capital home">
          <span class="brand-lockup__mark">Lir</span>
          <span class="brand-lockup__meta">Capital Partners</span>
        </a>
        <nav class="primary-nav" aria-label="Primary navigation">
          <ul class="nav-list">
            {primaryNav.map((item) => (
              <li>
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  <span>{item.label}</span>
                  <small>{item.cue}</small>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </header>
      <main id="main-content" tabindex="-1">
        <slot />
      </main>
      <footer class="site-footer">
        <div class="footer-register" aria-label="Entity disclosure">
          <span class="footer-register__label">Pre-production disclosure</span>
          <p>
            Harmonycove Limited trading as Lir Capital Partners. Registered in Ireland. Company No. 801328.
          </p>
        </div>
        <nav class="footer-nav" aria-label="Footer navigation">
          <a href="/legal/">Legal</a>
          <a href="/contact/">Contact</a>
          <a href="/">Home</a>
        </nav>
      </footer>
    </div>
  </body>
</html>
